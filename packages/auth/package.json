{
  "name": "@tower/auth",
  "version": "0.1.0",
  "private": true,
  "description": "TowerOS Authentication - JWT-based auth with refresh tokens, RBAC, and MFA support",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tower/database": "workspace:*",
    "@tower/shared": "workspace:*",
    "@tower/validators": "workspace:*",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "ulid": "^2.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
